<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>OpenPush Example</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- The scheme the Live Activity widget's tracking URL redirects back to.
         A literal, not a build setting: the widget hard-codes the same scheme,
         and the two have to match for the tap to reach the app. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>openpush-example</string>
            </array>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>OpenPushSDKKey</key>
    <string>$(OPENPUSH_SDK_KEY)</string>
    <key>OpenPushAppID</key>
    <string>$(OPENPUSH_APP_ID)</string>
    <key>OpenPushExampleAppGroup</key>
    <string>$(OPENPUSH_APP_GROUP)</string>
    <key>OpenPushExampleKeychainGroup</key>
    <string>$(OPENPUSH_KEYCHAIN_GROUP)</string>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
