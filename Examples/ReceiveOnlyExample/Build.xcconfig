// Every identifier and credential this sample needs, in one file.
//
// The values below are the Demo-mode defaults: placeholder ids that build and
// run without a signing team, and placeholder credentials that keep the app in
// Demo mode. For Live mode, copy `Local.xcconfig.example` to `Local.xcconfig`,
// fill it in, and run `xcodegen generate` again — the optional include at the
// bottom overrides whichever of these you set there.
//
// `Local.xcconfig` is git-ignored, so your team id and SDK key stay out of the
// repository.

// Your Apple Developer team. Empty is fine for a Simulator-only Demo build.
DEVELOPMENT_TEAM =

// The reverse-DNS prefix every target's bundle id is built from.
OPENPUSH_BUNDLE_PREFIX = ai.openpush.example

// The App Group the app mirrors its OpenPush configuration and APNs token into,
// and the Notification Service Extension reads them back out of. Used by both
// entitlements files and by both Info.plists.
OPENPUSH_APP_GROUP = group.ai.openpush.example

// The shared Keychain access group holding this install's device credential.
// Live builds need the real team id in front of it, which is what
// `Local.xcconfig.example` spells out.
OPENPUSH_KEYCHAIN_GROUP = TEAMID.ai.openpush.example.shared

// The credentials from the OpenPush console. Left as placeholders the app stays
// in Demo mode and never talks to a server.
OPENPUSH_APP_ID = replace-with-app-id
OPENPUSH_SDK_KEY = replace-with-public-sdk-key

// Optional by design: a checkout with no `Local.xcconfig` still generates and
// builds.
#include? "Local.xcconfig"
