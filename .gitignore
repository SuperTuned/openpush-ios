.swiftpm/
*.xcodeproj/
Examples/*/Local.xcconfig
build/
# The setup tool's fixtures are committed projects, generated once by XcodeGen.
!Tools/OpenPushSetup/Tests/Fixtures/*/*.xcodeproj/

